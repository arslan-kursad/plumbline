{
  "format_version": "1.2",
  "_comment": "A second budget bound to billing-alerts. The gross-cost alert budget (ADR-0004 Amendment 2, D3) reports a figure that is non-zero during entirely free operation; giving it a Pub/Sub binding would detach billing on ordinary usage. The guard must refuse this.",
  "resource_changes": [
    {
      "address": "google_billing_budget.zero_spend",
      "type": "google_billing_budget",
      "name": "zero_spend",
      "change": {
        "actions": ["update"],
        "after": {
          "display_name": "plumbline zero-spend",
          "all_updates_rule": [ { "pubsub_topic": "projects/plumbline-19458/topics/billing-alerts", "schema_version": "1.0" } ]
        }
      }
    },
    {
      "address": "google_billing_budget.gross_cost_alert",
      "type": "google_billing_budget",
      "name": "gross_cost_alert",
      "change": {
        "actions": ["create"],
        "after": {
          "display_name": "plumbline gross-cost alert",
          "all_updates_rule": [ { "pubsub_topic": "projects/plumbline-19458/topics/billing-alerts", "schema_version": "1.0" } ]
        }
      }
    }
  ]
}
