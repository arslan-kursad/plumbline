# OS
.DS_Store

# Go
collector/collector
*.test
*.out

# .NET
bin/
obj/
*.user

# Python — the CI guards are scripts, not a package; bytecode is never committed
__pycache__/
*.pyc

# Terraform — environment-specific inputs and state, never the pinned lock file
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
backend.hcl
*.tfplan
.terraform.lock.hcl.backup
crash.log

# Credentials — never committed
*.key.json
*service-account*.json
*credentials*.json
.env
.env.*

# Editors
.vscode/
.idea/

# Local end-to-end run state: a generated API key and query output, never committed.
.e2e/
# The cloud harness's working directory. It holds the run corpus, the locally
# normalized rows and the result document -- none of which is an artefact of the
# repository, and the corpus carries a per-run identity that means nothing after
# its run. Added after the first real run wrote it into an untracked directory
# nothing was ignoring.
.e2e-cloud/
