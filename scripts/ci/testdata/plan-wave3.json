      "change": {
        "actions": ["create"],
        "after": {
          "topic": "traces-dlq",
          "role": "roles/pubsub.publisher",
          "member": "serviceAccount:service-911930495850@gcp-sa-pubsub.iam.gserviceaccount.com"
        }
      }
    },
    {
      "address": "google_pubsub_subscription_iam_member.pubsub_agent_acks_traces_push",
      "type": "google_pubsub_subscription_iam_member",
      "name": "pubsub_agent_acks_traces_push",
      "change": {
        "actions": ["create"],
        "after": {
          "subscription": "traces-push",
          "role": "roles/pubsub.subscriber",
          "member": "serviceAccount:service-911930495850@gcp-sa-pubsub.iam.gserviceaccount.com"
