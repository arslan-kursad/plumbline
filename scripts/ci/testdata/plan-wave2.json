{
  "format_version": "1.2",
  "_comment": "Wave 2's shapes: two Cloud Run v2 services inside the guardrails, and the three IAM types added to the §7.1 allowlist for them. Exists so the guard is proven to read `template.scaling` on the real addresses rather than only on a violating fixture — F2 DoD 6.",
  "resource_changes": [
    {
      "address": "google_cloud_run_v2_service.collector",
      "type": "google_cloud_run_v2_service",
      "name": "collector",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "collector",
          "location": "us-central1",
          "ingress": "INGRESS_TRAFFIC_ALL",
          "template": [ { "scaling": [ { "min_instance_count": 0, "max_instance_count": 2 } ] } ]
        }
      }
    },
    {
      "address": "google_cloud_run_v2_service.worker",
      "type": "google_cloud_run_v2_service",
      "name": "worker",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "ingestion-worker",
          "location": "us-central1",
          "ingress": "INGRESS_TRAFFIC_INTERNAL_ONLY",
          "template": [ { "scaling": [ { "min_instance_count": 0, "max_instance_count": 2 } ] } ]
        }
      }
    },
    {
      "address": "google_cloud_run_v2_service_iam_member.collector_public",
      "type": "google_cloud_run_v2_service_iam_member",
      "name": "collector_public",
      "change": {
        "actions": ["create"],
        "after": { "location": "us-central1", "role": "roles/run.invoker", "member": "allUsers" }
      }
    },
    {
      "address": "google_pubsub_topic_iam_member.collector_publishes_traces",
      "type": "google_pubsub_topic_iam_member",
      "name": "collector_publishes_traces",
      "change": {
        "actions": ["create"],
        "after": { "topic": "traces", "role": "roles/pubsub.publisher" }
      }
    },
    {
      "address": "google_bigquery_table_iam_member.worker_writes_spans",
      "type": "google_bigquery_table_iam_member",
      "name": "worker_writes_spans",
      "change": {
        "actions": ["create"],
        "after": { "dataset_id": "plumbline", "table_id": "spans", "role": "roles/bigquery.dataEditor" }
      }
    },
    {
      "address": "google_service_account.collector",
      "type": "google_service_account",
      "name": "collector",
      "change": {
        "actions": ["create"],
        "after": { "account_id": "collector" }
      }
    }
  ]
}
