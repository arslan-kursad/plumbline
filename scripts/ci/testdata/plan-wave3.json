{
  "format_version": "1.2",
  "_comment": "Wave 3's intended shape: the push subscription, the push identity as the worker's sole invoker, and the Pub/Sub service agent's two dead-letter grants. allUsers on the collector is the project's one deliberate public endpoint and must still pass.",
  "resource_changes": [
    {
      "address": "google_pubsub_subscription.traces_push",
      "type": "google_pubsub_subscription",
      "name": "traces_push",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "traces-push",
          "ack_deadline_seconds": 60,
          "message_retention_duration": "604800s",
          "retain_acked_messages": false,
          "dead_letter_policy": [
            {
              "dead_letter_topic": "projects/plumbline-19458/topics/traces-dlq",
              "max_delivery_attempts": 5
            }
          ]
        }
      }
    },
    {
      "address": "google_cloud_run_v2_service_iam_member.worker_push_invoker",
      "type": "google_cloud_run_v2_service_iam_member",
      "name": "worker_push_invoker",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "ingestion-worker",
          "location": "us-central1",
          "role": "roles/run.invoker",
          "member": "serviceAccount:pubsub-push@plumbline-19458.iam.gserviceaccount.com"
        }
      }
    },
    {
      "address": "google_cloud_run_v2_service_iam_member.collector_public",
      "type": "google_cloud_run_v2_service_iam_member",
      "name": "collector_public",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "collector",
          "location": "us-central1",
          "role": "roles/run.invoker",
          "member": "allUsers"
        }
      }
    },
    {
      "address": "google_pubsub_topic_iam_member.pubsub_agent_publishes_dlq",
      "type": "google_pubsub_topic_iam_member",
